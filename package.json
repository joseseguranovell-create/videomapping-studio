{
  "name": "videomapping-studio",
  "version": "0.1.0",
  "description": "Estudio de videomapping para fachadas, ventanas y escenarios",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "node scripts/build-main.mjs && vite build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "author": "Videomapping Studio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "earcut": "3.0.2",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.11",
    "immer": "10.1.3",
    "lucide-react": "0.548.0",
    "playwright": "1.59.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "productName": "Videomapping Studio",
  "private": true,
  "build": {
    "appId": "es.videomappingstudio.app",
    "productName": "Videomapping Studio",
    "copyright": "Videomapping Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/packs",
        "to": "packs"
      },
      {
        "from": "resources/mcp",
        "to": "mcp"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Videomapping-Studio-${version}-win-x64-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Videomapping Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Videomapping-Studio-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "publish": null
  }
}
